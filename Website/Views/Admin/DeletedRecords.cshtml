@model List<Website.Models.DeletedRecord>
@{
    ViewData["Title"] = "Deleted Records Audit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header" style="background: linear-gradient(135deg, #dc3545, #c82333);">
            <h2 class="text-white mb-0"><i class="fas fa-trash"></i> Deleted Records Audit</h2>
            <p class="text-white-50 mb-0">Track all deleted user accounts</p>
        </div>
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> No deleted records found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Deleted User</th>
                                <th>User Role</th>
                                <th>Deleted By</th>
                                <th>Deleted By Role</th>
                                <th>Deleted At</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model)
                            {
                                <tr>
                                    <td>@record.UserEmail</td>
                                    <td>
                                        <span class="badge @(record.UserRole == "Admin" ? "bg-danger" : record.UserRole == "Content_Creator" ? "bg-success" : "bg-primary")">
                                            @record.UserRole
                                        </span>
                                    </td>
                                    <td>@record.DeletedByEmail</td>
                                    <td>
                                        <span class="badge @(record.DeletedByRole == "Admin" ? "bg-danger" : "bg-warning")">
                                            @record.DeletedByRole
                                        </span>
                                    </td>
                                    <td>@record.DeletedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@(record.Reason ?? "Account deleted by admin")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}