@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">Admin Dashboard</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-3x"></i>
                    <h3 class="mt-2">@ViewBag.TotalUsers</h3>
                    <p>Total Users</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success">
                <div class="card-body text-center">
                    <i class="fas fa-graduation-cap fa-3x"></i>
                    <h3 class="mt-2">@ViewBag.TotalLearners</h3>
                    <p>Learners</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info">
                <div class="card-body text-center">
                    <i class="fas fa-edit fa-3x"></i>
                    <h3 class="mt-2">@ViewBag.TotalCreators</h3>
                    <p>Content Creators</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning">
                <div class="card-body text-center">
                    <i class="fas fa-book fa-3x"></i>
                    <h3 class="mt-2">@ViewBag.TotalContent</h3>
                    <p>Total Content</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-3 mb-3">
            <a asp-action="Learners" class="text-decoration-none">
                <div class="card text-center h-100 shadow-sm">
                    <div class="card-body">
                        <i class="fas fa-users fa-3x text-primary"></i>
                        <h5>Manage Learners</h5>
                        <p class="small">View, search, and delete learners</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-action="ContentCreators" class="text-decoration-none">
                <div class="card text-center h-100 shadow-sm">
                    <div class="card-body">
                        <i class="fas fa-edit fa-3x text-success"></i>
                        <h5>Manage Creators</h5>
                        <p class="small">View content creators</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-action="DeletedRecords" class="text-decoration-none">
                <div class="card text-center h-100 shadow-sm">
                    <div class="card-body">
                        <i class="fas fa-trash fa-3x text-danger"></i>
                        <h5>Deleted Records</h5>
                        <p class="small">Audit trail of deletions</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-action="Promotions" class="text-decoration-none">
                <div class="card text-center h-100 shadow-sm">
                    <div class="card-body">
                        <i class="fas fa-bullhorn fa-3x text-warning"></i>
                        <h5>Promotions</h5>
                        <p class="small">Create and manage promotions</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>