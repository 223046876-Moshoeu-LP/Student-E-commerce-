@model List<Website.Models.ApplicationUser>
@{
    ViewData["Title"] = "Learners Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header" style="background: linear-gradient(135deg, #008080, #006666);">
            <h2 class="text-white mb-0"><i class="fas fa-users"></i> Learners Management</h2>
        </div>
        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <div class="mb-3">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by email or name...">
            </div>

            <div id="learnersList">
                @await Html.PartialAsync("_LearnerList", Model)
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById("searchInput").addEventListener("keyup", function() {
        var input = this.value.toLowerCase();
        var rows = document.querySelectorAll("#learnersList table tbody tr");

        rows.forEach(function(row) {
            var email = row.cells[1]?.innerText.toLowerCase() || "";
            var name = row.cells[2]?.innerText.toLowerCase() || "";

            if (email.indexOf(input) > -1 || name.indexOf(input) > -1) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    });
</script>