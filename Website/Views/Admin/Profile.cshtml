@using System.Security.Claims
@model Website.Models.ApplicationUser
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Profile";
    var isOwner = User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.Id;
    var isAdmin = User.IsInRole("Admin");
    var canEdit = isOwner || isAdmin;
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Profile Image Section -->
        <div class="col-md-4">
            <div class="card shadow-lg mb-4">
                <div class="card-header" style="background: linear-gradient(135deg, #dc3545, #c82333);">
                    <h4 class="text-white mb-0">
                        <i class="fas fa-user-shield"></i>
                        Admin Profile Picture
                    </h4>
                </div>
                <div class="card-body text-center">
                    <img src="@(Model.ProfileImageUrl ?? "/Images/DefaultPic.png")"
                         alt="@Model.FirstName @Model.LastName"
                         class="rounded-circle mb-3"
                         style="width: 180px; height: 180px; object-fit: cover; border: 4px solid #FFD700; box-shadow: 0 4px 8px rgba(0,0,0,0.2);">

                    @if (canEdit)
                    {
                        <form asp-controller="Admin" asp-action="UploadProfileImage" method="post" enctype="multipart/form-data" id="imageUploadForm">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <input type="file" name="profileImage" id="profileImage" class="form-control" accept="image/jpeg,image/png,image/jpg" style="display: none;" onchange="document.getElementById('imageUploadForm').submit();" />
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('profileImage').click();">
                                    <i class="fas fa-upload"></i> Upload New Image
                                </button>
                                @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm ms-2" onclick="confirmRemoveImage()">
                                        <i class="fas fa-trash-alt"></i> Remove Image
                                    </button>
                                }
                            </div>
                        </form>

                        <form asp-controller="Admin" asp-action="RemoveProfileImage" method="post" id="removeImageForm">
                            @Html.AntiForgeryToken()
                        </form>

                        <small class="text-muted">Supported formats: JPG, PNG (Max 5MB)</small>
                    }
                </div>
            </div>

            <!-- Admin Stats Card -->
            <div class="card shadow-lg">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-line"></i> Admin Stats</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <h3 class="text-primary">@ViewBag.TotalUsers</h3>
                        <p class="text-muted">Total Users</p>
                    </div>
                    <div class="text-center mb-3">
                        <h3 class="text-success">@ViewBag.TotalContent</h3>
                        <p class="text-muted">Total Content</p>
                    </div>
                    <hr />
                    <div class="text-center">
                        <small class="text-muted">Admin since: @(Model.CreatedAt?.ToString("MMMM dd, yyyy") ?? "Not specified")</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile Information Section -->
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header" style="background: linear-gradient(135deg, #dc3545, #c82333);">
                    <h4 class="text-white mb-0">
                        <i class="fas fa-@(canEdit ? "edit" : "info-circle")"></i>
                        @(canEdit ? "Edit Admin Profile" : "Admin Information")
                    </h4>
                </div>
                <div class="card-body">
                    @if (canEdit)
                    {
                        <form asp-controller="Admin" asp-action="Profile" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="FirstName" class="form-label fw-bold">First Name</label>
                                        <input asp-for="FirstName" class="form-control" required />
                                        <span asp-validation-for="FirstName" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="LastName" class="form-label fw-bold">Last Name</label>
                                        <input asp-for="LastName" class="form-control" required />
                                        <span asp-validation-for="LastName" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                                <input asp-for="Email" class="form-control" readonly disabled />
                                <small class="text-muted">Email cannot be changed</small>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Bio" class="form-label fw-bold">Bio</label>
                                <textarea asp-for="Bio" class="form-control" rows="3"
                                          placeholder="Tell us about yourself..."></textarea>
                                <span asp-validation-for="Bio" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Role</label>
                                <input type="text" class="form-control" value="Administrator" readonly disabled />
                                <small class="text-muted">Full system access</small>
                            </div>

                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Permissions</label>
                                <div class="border rounded p-3 bg-light">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" checked disabled />
                                        <label class="form-check-label">Manage Users</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" checked disabled />
                                        <label class="form-check-label">Manage Content</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" checked disabled />
                                        <label class="form-check-label">Manage Promotions</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" checked disabled />
                                        <label class="form-check-label">View Reports</label>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-danger btn-lg w-100">
                                <i class="fas fa-save"></i> Save Profile Changes
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg w-100 mt-2">
                                <i class="fas fa-tachometer-alt"></i> Back to Dashboard
                            </a>
                        </form>
                    }
                    else
                    {
                        <!-- Read-only view for others -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-muted">First Name</label>
                                    <p class="form-control-static">@Model.FirstName</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-muted">Last Name</label>
                                    <p class="form-control-static">@Model.LastName</p>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Email</label>
                            <p class="form-control-static">@Model.Email</p>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Bio</label>
                            <p class="form-control-static">@(string.IsNullOrEmpty(Model.Bio) ? "No bio provided." : Model.Bio)</p>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Role</label>
                            <p class="form-control-static"><span class="badge bg-danger">Administrator</span></p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function confirmRemoveImage() {
            if (confirm('Are you sure you want to remove your profile image?')) {
                document.getElementById('removeImageForm').submit();
            }
        }

        // Preview image before upload
        document.addEventListener('DOMContentLoaded', function() {
            var profileImageInput = document.getElementById('profileImage');
            if (profileImageInput) {
                profileImageInput.addEventListener('change', function(e) {
                    if (e.target.files && e.target.files[0]) {
                        var reader = new FileReader();
                        reader.onload = function(e) {
                            var img = document.querySelector('.rounded-circle');
                            if (img) {
                                img.src = e.target.result;
                            }
                        };
                        reader.readAsDataURL(e.target.files[0]);
                    }
                });
            }
        });
    </script>
}