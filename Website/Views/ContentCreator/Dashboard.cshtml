@model List<Website.Models.Content>
@{
    ViewData["Title"] = "Creator Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header" style="background: linear-gradient(135deg, #008080, #006666);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="text-white mb-0"><i class="fas fa-edit"></i> Creator Dashboard</h2>
                    <p class="text-white-50 mb-0">Welcome back, @User.Identity?.Name!</p>
                </div>
                <div>
                    <a asp-action="Profile" class="text-decoration-none">
                        <img src="~/Images/DefaultPic.png" alt="Profile" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover; border: 2px solid #FFD700; cursor: pointer;">
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Stats Cards -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body text-center">
                            <i class="fas fa-book fa-3x"></i>
                            <h3 class="mt-2">@ViewBag.TotalContent</h3>
                            <p>Total Content</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <i class="fas fa-check-circle fa-3x"></i>
                            <h3 class="mt-2">@ViewBag.PublishedContent</h3>
                            <p>Published</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body text-center">
                            <i class="fas fa-shopping-cart fa-3x"></i>
                            <h3 class="mt-2">@ViewBag.TotalSales</h3>
                            <p>Total Sales</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-white">
                        <div class="card-body text-center">
                            <i class="fas fa-dollar-sign fa-3x"></i>
                            <h3 class="mt-2">$@(ViewBag.TotalRevenue?.ToString("F2") ?? "0.00")</h3>
                            <p>Total Revenue</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Content -->
            <h3>Recent Content</h3>
            <hr />
            <div class="row">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model.Take(3))
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card h-100 shadow-sm">
                                <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "https://placehold.co/400x200/008080/white?text=" + Uri.EscapeDataString(item.Title ?? "Content") : item.ThumbnailUrl)"
                                     class="card-img-top" alt="@item.Title" style="height: 150px; object-fit: cover;">
                                <div class="card-body">
                                    <h5 class="card-title">@item.Title</h5>
                                    <p class="card-text text-muted">@(item.Description?.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description ?? "No description")</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge bg-primary">@item.Category</span>
                                        <span class="text-success fw-bold">$@item.Price.ToString("F2")</span>
                                    </div>
                                    <div class="mt-2">
                                        @if (item.IsPublished)
                                        {
                                            <span class="badge bg-success">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Draft</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent">
                                    <div class="btn-group w-100" role="group">
                                        <a asp-action="EditContent" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i> Edit Content
                                        </a>
                                     
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- View All Content Link -->
                    <div class="col-md-12 text-center mt-3">
                        <a asp-action="MyContent" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-right"></i> View All Content (@Model.Count items)
                        </a>
                    </div>
                }
                else
                {
                    <div class="col-md-12">
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle fa-2x mb-2 d-block"></i>
                            <p>You haven't created any content yet.</p>
                            <a asp-action="CreateContent" class="btn btn-success">
                                <i class="fas fa-plus-circle"></i> Create Your First Content
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this content?</p>
                <p class="text-danger">This action cannot be undone!</p>
                <p>All associated files will also be deleted.</p>
            </div>
            <div class="modal-footer">
                <form asp-action="DeleteContent" method="post" id="deleteForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteContentId" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete Permanently</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <script>
        function confirmDelete(id) {
            document.getElementById('deleteContentId').value = id;
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }
    </script>
}