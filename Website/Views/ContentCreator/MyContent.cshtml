@model List<Website.Models.Content>
@{
    ViewData["Title"] = "My Content";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0"><i class="fas fa-list"></i> My Content</h2>
                    <p class="mb-0">Manage your courses and materials</p>
                </div>
                <a asp-action="CreateContent" class="btn btn-light">
                    <i class="fas fa-plus"></i> Create New
                </a>
            </div>
        </div>
        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Thumbnail</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td style="vertical-align: middle">
                                        <img src="@(item.ThumbnailUrl ?? "/images/default-course.jpg")"
                                             style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;">
                                    </td>
                                    <td style="vertical-align: middle">@item.Title</td>
                                    <td style="vertical-align: middle">
                                        <span class="badge bg-primary">@item.Category</span>
                                    </td>
                                    <td style="vertical-align: middle" class="text-success fw-bold">$@item.Price</td>
                                    <td style="vertical-align: middle">
                                        @if (item.IsPublished)
                                        {
                                            <span class="badge bg-success">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Draft</span>
                                        }
                                    </td>
                                    <td style="vertical-align: middle">@item.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    <td style="vertical-align: middle">
                                        <a asp-action="EditContent" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form asp-action="TogglePublish" asp-route-id="@item.Id" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(item.IsPublished ? "btn-warning" : "btn-success")">
                                                <i class="fas @(item.IsPublished ? "fa-eye-slash" : "fa-eye")"></i>
                                                @(item.IsPublished ? "Unpublish" : "Publish")
                                            </button>
                                        </form>
                                        <form asp-action="DeleteContent" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this content?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-info-circle fa-4x text-muted mb-3"></i>
                    <h4>You haven't created any content yet.</h4>
                    <p>Start sharing your knowledge with the world!</p>
                    <a asp-action="CreateContent" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Create Your First Content
                    </a>
                </div>
            }
        </div>
        <div class="card-footer">
            <a asp-action="Dashboard" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}