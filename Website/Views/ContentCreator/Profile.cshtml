@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Profile";
}

@model Website.Models.ApplicationUser

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-lg">
                <div class="card-header" style="background: linear-gradient(135deg, #008080, #006666);">
                    <h4 class="text-white mb-0"><i class="fas fa-user-circle"></i> Profile Picture</h4>
                </div>
                <div class="card-body text-center">
                    <img src="@(ViewBag.ProfileImage ?? "~/Images/DefaultPic.png")" alt="@Model.FirstName @Model.LastName"
                         class="rounded-circle mb-3"
                         style="width: 180px; height: 180px; object-fit: cover; border: 4px solid #FFD700; box-shadow: 0 4px 8px rgba(0,0,0,0.2);">

                    <form asp-action="UploadProfileImage" method="post" enctype="multipart/form-data" id="imageUploadForm">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <input type="file" name="profileImage" id="profileImage"
                                   class="form-control" accept="image/jpeg,image/png,image/jpg,image/gif"
                                   style="display: none;" onchange="document.getElementById('imageUploadForm').submit();" />
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('profileImage').click();">
                                <i class="fas fa-upload"></i> Upload New Image
                            </button>
                            @if (ViewBag.HasImage == true)
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm ms-2" onclick="confirmRemoveImage()">
                                    <i class="fas fa-trash-alt"></i> Remove Image
                                </button>
                            }
                        </div>
                    </form>

                    <form asp-action="RemoveProfileImage" method="post" id="removeImageForm">
                        @Html.AntiForgeryToken()
                    </form>

                    <small class="text-muted">Supported formats: JPG, PNG, GIF (Max 50MB)</small>

                    <!-- Creator Stats -->
                    <hr class="mt-3">
                    <div class="row mt-2">
                        <div class="col-6">
                            <h5 class="text-primary">@ViewBag.ContentCount</h5>
                            <small class="text-muted">Content Items</small>
                        </div>
                        <div class="col-6">
                            <h5 class="text-success">@ViewBag.TotalSales</h5>
                            <small class="text-muted">Total Sales</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header" style="background: linear-gradient(135deg, #28a745, #20c997);">
                    <h4 class="text-white mb-0"><i class="fas fa-edit"></i> Edit Profile Information</h4>
                    <p class="text-white-50 mb-0">Update your personal and professional details</p>
                </div>
                <div class="card-body">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="fas fa-check-circle"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Profile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="FirstName" class="form-label fw-bold">First Name</label>
                                    <input asp-for="FirstName" class="form-control" required />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="LastName" class="form-label fw-bold">Last Name</label>
                                    <input asp-for="LastName" class="form-control" required />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                            <input asp-for="Email" class="form-control" readonly disabled />
                            <small class="text-muted">Email cannot be changed</small>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Bio" class="form-label fw-bold">Biography</label>
                            <textarea asp-for="Bio" class="form-control" rows="4"
                                      placeholder="Tell learners about yourself, your expertise, and what they can expect from your content..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger"></span>
                            <small class="text-muted">A brief description about yourself and your content</small>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Expertise" class="form-label fw-bold">Expertise / Skills</label>
                            <input asp-for="Expertise" class="form-control"
                                   placeholder="e.g., Web Development, Mobile Apps, Data Science, UI/UX Design" />
                            <small class="text-muted">Separate multiple skills with commas</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Website" class="form-label fw-bold">Personal Website</label>
                                    <input asp-for="Website" class="form-control" placeholder="https://yourwebsite.com" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Twitter" class="form-label fw-bold">Twitter/X Handle</label>
                                    <input asp-for="Twitter" class="form-control" placeholder="https://twitter.com/yourhandle" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="LinkedIn" class="form-label fw-bold">LinkedIn Profile</label>
                            <input asp-for="LinkedIn" class="form-control" placeholder="https://linkedin.com/in/yourprofile" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Role</label>
                            <input type="text" class="form-control" value="Content Creator" readonly disabled />
                            <small class="text-muted">Your role determines your access permissions</small>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Member Since</label>
                            <input type="text" class="form-control" value="@(Model.CreatedAt?.ToString("MMMM dd, yyyy") ?? DateTime.Now.ToString("MMMM dd, yyyy"))" readonly disabled />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-save"></i> Save Profile Changes
                            </button>
                            <a asp-action="Dashboard" class="btn btn-primary btn-lg">
                                <i class="fas fa-tachometer-alt"></i> Back to Dashboard
                            </a>
                            <a asp-action="MyContent" class="btn btn-info btn-lg">
                                <i class="fas fa-book"></i> Manage My Content
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <script>
        function confirmRemoveImage() {
            if (confirm('Are you sure you want to remove your profile image?')) {
                document.getElementById('removeImageForm').submit();
            }
        }

        // Preview image before upload
        document.getElementById('profileImage')?.addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = document.querySelector('.rounded-circle');
                    if (img) {
                        img.src = e.target.result;
                    }
                };
                reader.readAsDataURL(e.target.files[0]);
            }
        });
    </script>
}
