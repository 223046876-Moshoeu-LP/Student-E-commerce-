@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-4">
    <!-- Hero Section -->
    <div class="row mb-5">
        <div class="col-md-12">
            <div class="card text-white" style="background: linear-gradient(135deg, #008080, #006666);">
                <div class="card-body text-center py-5">
                    <h1 class="display-4">About BrightWeb Crafters Connect</h1>
                    <p class="lead">Empowering education through technology since 2024</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Company Background -->
    <div class="row mb-5">
        <div class="col-md-12">
            <div class="card shadow-lg">
                <div class="card-body">
                    <h2 class="text-primary">Company Background & Rationale</h2>
                    <p class="lead">The South African education and skills development sector plays a critical role in employment creation and economic participation.</p>
                    <p>However, despite numerous opportunities in the digital economy, many aspiring learners and content creators remain excluded due to lack of access to quality learning resources, limited platforms to share knowledge, or inadequate digital infrastructure.</p>
                    <p><strong>BrightWeb Crafters Connect</strong> was formed to address this reality from a practical, hands-on perspective. Rather than offering fragmented services, the platform provides an integrated learning and content creation solution tailored to the real needs of learners and educators.</p>
                    <p>Many individuals possess valuable knowledge but lack the platform to share it. Others are eager to learn but struggle to find quality, affordable courses. BrightWeb Crafters Connect positions itself as a bridge between knowledge creators and knowledge seekers, allowing both to focus on what matters most - learning and growth.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Vision & Mission -->
    <div class="row mb-5">
        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-lg">
                <div class="card-header" style="background: linear-gradient(135deg, #008080, #006666);">
                    <h3 class="text-white mb-0"><i class="fas fa-eye"></i> Our Vision</h3>
                </div>
                <div class="card-body">
                    <p>To become a leading digital learning platform in South Africa, connecting knowledge creators with eager learners, contributing to skills development, economic participation, and lifelong learning.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-lg">
                <div class="card-header" style="background: linear-gradient(135deg, #28a745, #20c997);">
                    <h3 class="text-white mb-0"><i class="fas fa-bullseye"></i> Our Mission</h3>
                </div>
                <div class="card-body">
                    <p>To democratize education by providing a platform where anyone can learn from industry experts and where experts can share their knowledge, building a community of continuous learning and growth.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Core Values -->
    <div class="row mb-5">
        <div class="col-md-12">
            <h2 class="text-center text-primary">Our Core Values</h2>
            <hr />
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-star fa-3x text-warning"></i>
                    <h4 class="mt-3">Excellence</h4>
                    <p>We strive for excellence in every course, ensuring high-quality content that meets industry standards.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-hand-holding-heart fa-3x text-danger"></i>
                    <h4 class="mt-3">Accessibility</h4>
                    <p>Making quality education accessible and affordable to everyone, regardless of background or location.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-users fa-3x text-primary"></i>
                    <h4 class="mt-3">Community</h4>
                    <p>Building a supportive community where learners and creators grow together.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Platform Features -->
    <div class="row mb-5">
        <div class="col-md-12">
            <h2 class="text-center text-primary">What We Offer</h2>
            <hr />
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-graduation-cap fa-2x text-primary"></i>
                    <h5>Quality Courses</h5>
                    <p>Expert-led courses across various fields including programming, design, business, and more.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-chalkboard-teacher fa-2x text-success"></i>
                    <h5>Expert Creators</h5>
                    <p>Learn from industry professionals who share real-world experience and practical knowledge.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-certificate fa-2x text-warning"></i>
                    <h5>Certificates</h5>
                    <p>Earn certificates upon completion to showcase your new skills and knowledge.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Testimonials -->
    <div class="row mb-5">
        <div class="col-md-12">
            <h2 class="text-center text-primary">What Our Learners Say</h2>
            <hr />
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-quote-left fa-2x text-muted"></i>
                    <p class="mt-3">"BrightWeb Crafters Connect has transformed the way I learn. The courses are well-structured and the instructors are amazing. I've completed three courses and each one has added value to my career."</p>
                    <div class="d-flex align-items-center mt-3">
                        <i class="fas fa-user-circle fa-2x text-secondary me-2"></i>
                        <div>
                            <strong>Thabo M.</strong>
                            <div class="text-warning">★★★★★</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-quote-left fa-2x text-muted"></i>
                    <p class="mt-3">"As a content creator, BrightWeb Crafters Connect gave me the platform to share my knowledge with thousands of students. The support and tools are excellent."</p>
                    <div class="d-flex align-items-center mt-3">
                        <i class="fas fa-user-circle fa-2x text-secondary me-2"></i>
                        <div>
                            <strong>Lindiwe N.</strong>
                            <div class="text-warning">★★★★★</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fas fa-quote-left fa-2x text-muted"></i>
                    <p class="mt-3">"The flexibility to learn at my own pace and the quality of content is unmatched. Highly recommended for anyone looking to upskill."</p>
                    <div class="d-flex align-items-center mt-3">
                        <i class="fas fa-user-circle fa-2x text-secondary me-2"></i>
                        <div>
                            <strong>Sipho K.</strong>
                            <div class="text-warning">★★★★★</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="row mb-5">
        <div class="col-md-12">
            <div class="card text-white text-center" style="background: linear-gradient(135deg, #008080, #006666);">
                <div class="card-body py-5">
                    <h2>Start Your Learning Journey Today</h2>
                    <p class="lead">Join thousands of learners and creators on BrightWeb Crafters Connect</p>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-gold btn-lg mt-3">Get Started</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        .btn-gold {
            background: linear-gradient(135deg, #FFD700, #DAA520);
            border: none;
            color: #006666;
            font-weight: bold;
            transition: all 0.3s ease;
        }

            .btn-gold:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(218,165,32,0.4);
                color: #006666;
            }

        .text-primary {
            color: #008080 !important;
        }

        .card {
            transition: transform 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
            }
    </style>
}