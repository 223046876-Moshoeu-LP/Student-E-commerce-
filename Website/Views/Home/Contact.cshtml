@{
    ViewData["Title"] = "Contact Us";
}

<div class="container mt-4">
    <div class="row mb-5">
        <div class="col-md-12">
            <div class="card text-white" style="background: linear-gradient(135deg, #008080, #006666);">
                <div class="card-body text-center py-5">
                    <h1 class="display-4">Contact Us</h1>
                    <p class="lead">We'd love to hear from you</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-lg h-100">
                <div class="card-body">
                    <h3><i class="fas fa-map-marker-alt text-primary"></i> Our Location</h3>
                    <p>283 Koppie Alleen, Reitzpark<br />Welkom, 9488<br />South Africa</p>

                    <h3 class="mt-4"><i class="fas fa-phone text-primary"></i> Phone</h3>
                    <p>+27 68 671 0428</p>

                    <h3 class="mt-4"><i class="fas fa-envelope text-primary"></i> Email</h3>
                    <p>info@brightwebcrafters.com</p>

                    <h3 class="mt-4"><i class="fas fa-clock text-primary"></i> Business Hours</h3>
                    <p>Monday - Friday: 8:00 AM - 5:00 PM<br />Saturday: 9:00 AM - 2:00 PM<br />Sunday: Closed</p>

                    <div class="mt-3">
                        <iframe src="https://www.google.com/maps?q=-27.9677792,26.7645874&output=embed"
                                width="100%"
                                height="300"
                                style="border:0;"
                                allowfullscreen=""
                                loading="lazy">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-lg h-100">
                <div class="card-body">
                    <h3><i class="fas fa-paper-plane text-primary"></i> Send Us a Message</h3>
                    <form asp-action="Contact" method="post">
                        @Html.AntiForgeryToken()

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">@TempData["Success"]</div>
                        }

                        <div class="form-group mb-3">
                            <label class="form-label">Your Name</label>
                            <input type="text" name="name" class="form-control" required />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Your Email</label>
                            <input type="email" name="email" class="form-control" required />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Subject</label>
                            <input type="text" name="subject" class="form-control" required />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Message</label>
                            <textarea name="message" class="form-control" rows="5" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}