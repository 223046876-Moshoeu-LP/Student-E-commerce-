@model List<Website.Models.Content>
@{
    ViewData["Title"] = "LearnConnect - Home";
}

<!-- Bootstrap Carousel Section -->
<div class="row mb-5">
    <div class="col-md-12">
        <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="2"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="/uploads/HomeScreen/Programming.jpeg" class="d-block w-100" alt="Learn Coding" style="height: 400px; object-fit: cover;">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-3">
                        <h3>Learn Programming</h3>
                        <p>Master C#, Python, JavaScript and more with expert-led courses</p>
                        <a asp-controller="Store" asp-action="Index" class="btn btn-gold">Explore Now</a>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="/uploads/HomeScreen/GraphicDesign_1.jpg" class="d-block w-100" alt="Design Courses" style="height: 400px; object-fit: cover;">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-3">
                        <h3>Creative Design</h3>
                        <p>Learn UI/UX, Graphic Design, and bring your ideas to life</p>
                        <a asp-controller="Store" asp-action="Index" class="btn btn-gold">Start Learning</a>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="/uploads/HomeScreen/Marketing2.jpg" class="d-block w-100" alt="Business Skills" style="height: 400px; object-fit: cover;">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-3">
                        <h3>Business & Marketing</h3>
                        <p>Develop leadership, management, and marketing skills</p>
                        <a asp-controller="Store" asp-action="Index" class="btn btn-gold">Get Started</a>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>
</div>

<!-- Hero Section -->
<div class="hero-section mb-5" style="background: linear-gradient(135deg, #008080, #006666); border-radius: 20px;">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-md-7 text-white">
                <h1 class="display-4 fw-bold">Learn Anything,<br />Anytime, Anywhere</h1>
                <p class="lead mt-3">Join thousands of learners and expert creators on the ultimate learning platform.</p>
                @if (!User.Identity.IsAuthenticated)
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-gold btn-lg mt-2 me-2">Get Started</a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-lg mt-2">Sign In</a>
                }
                else if (User.IsInRole("User"))
                {
                    <a asp-controller="Learner" asp-action="Dashboard" class="btn btn-gold btn-lg mt-2">Go to Dashboard</a>
                }
                else if (User.IsInRole("Content_Creator"))
                {
                    <a asp-controller="ContentCreator" asp-action="Dashboard" class="btn btn-gold btn-lg mt-2">Creator Dashboard</a>
                }
                else
                {
                    <a asp-controller="Store" asp-action="Index" class="btn btn-gold btn-lg mt-2">Explore Courses</a>
                }
            </div>
            <div class="col-md-5 text-center">
                <i class="fas fa-laptop-code fa-8x text-white opacity-75"></i>
            </div>
        </div>
    </div>
</div>

<!-- Featured Courses Section -->
<div class="row mb-4">
    <div class="col-md-12">
        <h2><i class="fas fa-star text-warning"></i> Featured Courses</h2>
        <hr />
    </div>
</div>

<div class="row" id="featuredCourses">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model.Take(3))
        {
            <div class="col-md-4 mb-4 course-card" data-category="@item.Category">
                <div class="card h-100 shadow-sm">
                    <img src="@(item.ThumbnailUrl ?? "https://placehold.co/400x200/008080/white?text=" + item.Title)" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary">@item.Category</span>
                            <span class="text-muted small"><i class="far fa-clock"></i> @item.Duration min</span>
                        </div>
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted">@(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="h5 text-success mb-0">$@item.Price.ToString("0.00")</span>
                            <a asp-controller="Store" asp-action="CourseDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- All Courses Section -->
<div class="row mb-4 mt-5">
    <div class="col-md-12">
        <h2><i class="fas fa-book"></i> All Courses</h2>
        <hr />
    </div>
</div>

<div class="row" id="allCourses">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4 course-card" data-category="@item.Category">
                <div class="card h-100 shadow-sm">
                    <img src="@(item.ThumbnailUrl ?? "https://placehold.co/300x150/008080/white?text=" + item.Title)" class="card-img-top" alt="@item.Title" style="height: 140px; object-fit: cover;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary" style="font-size: 10px;">@item.Category</span>
                            <span class="text-muted small"><i class="far fa-clock"></i> @item.Duration min</span>
                        </div>
                        <h6 class="card-title">@item.Title</h6>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="text-success fw-bold">$@item.Price.ToString("0.00")</span>
                            <a asp-controller="Store" asp-action="CourseDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-md-12">
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle"></i> No courses available yet. Check back soon!
            </div>
        </div>
    }
</div>

<!-- Popular Categories -->
<div class="row mb-4 mt-5">
    <div class="col-md-12">
        <h2><i class="fas fa-tags"></i> Popular Categories</h2>
        <hr />
    </div>
</div>

<div class="row mb-5">
    <div class="col-md-2 col-6 mb-3">
        <div class="category-card text-center p-3 shadow-sm" data-cat="Programming">
            <i class="fab fa-python fa-3x text-primary"></i>
            <h6 class="mt-2 mb-0">Programming</h6>
            <small class="text-muted">24 courses</small>
        </div>
    </div>
    <div class="col-md-2 col-6 mb-3">
        <div class="category-card text-center p-3 shadow-sm" data-cat="Design">
            <i class="fas fa-paint-brush fa-3x text-success"></i>
            <h6 class="mt-2 mb-0">Design</h6>
            <small class="text-muted">12 courses</small>
        </div>
    </div>
    <div class="col-md-2 col-6 mb-3">
        <div class="category-card text-center p-3 shadow-sm" data-cat="Data Science">
            <i class="fas fa-chart-line fa-3x text-info"></i>
            <h6 class="mt-2 mb-0">Data Science</h6>
            <small class="text-muted">8 courses</small>
        </div>
    </div>
    <div class="col-md-2 col-6 mb-3">
        <div class="category-card text-center p-3 shadow-sm" data-cat="Business">
            <i class="fas fa-chart-simple fa-3x text-warning"></i>
            <h6 class="mt-2 mb-0">Business</h6>
            <small class="text-muted">15 courses</small>
        </div>
    </div>
    <div class="col-md-2 col-6 mb-3">
        <div class="category-card text-center p-3 shadow-sm" data-cat="Marketing">
            <i class="fas fa-bullhorn fa-3x text-danger"></i>
            <h6 class="mt-2 mb-0">Marketing</h6>
            <small class="text-muted">10 courses</small>
        </div>
    </div>
    <div class="col-md-2 col-6 mb-3">
        <div class="category-card text-center p-3 shadow-sm" data-cat="Podcast">
            <i class="fas fa-podcast fa-3x text-secondary"></i>
            <h6 class="mt-2 mb-0">Podcasts</h6>
            <small class="text-muted">6 podcasts</small>
        </div>
    </div>
</div>

<!-- Promotional Banner -->
<div class="row mb-5">
    <div class="col-md-12">
        <div class="card text-dark" style="background: linear-gradient(135deg, #FFD700, #DAA520); border-radius: 20px;">
            <div class="card-body text-center py-4">
                <h3><i class="fas fa-fire"></i> Limited Time Offer!</h3>
                <p class="lead">Get 30% off on all courses this week only!</p>
                <p>Use code: <strong>LEARN30</strong> at checkout</p>
                <a asp-controller="Store" asp-action="Index" class="btn btn-dark">Shop Now</a>
            </div>
        </div>
    </div>
</div>

<script>
    // Carousel Pause on Hover
    var carousel = document.getElementById('mainCarousel');
    if (carousel) {
        carousel.addEventListener('mouseenter', function() {
            var bsCarousel = bootstrap.Carousel.getInstance(carousel);
            if (bsCarousel) bsCarousel.pause();
        });
        carousel.addEventListener('mouseleave', function() {
            var bsCarousel = bootstrap.Carousel.getInstance(carousel);
            if (bsCarousel) bsCarousel.cycle();
        });
    }

    // Popular category cards click
    document.querySelectorAll('.category-card').forEach(card => {
        card.addEventListener('click', function() {
            var category = this.getAttribute('data-cat');
            var courses = document.querySelectorAll("#allCourses .course-card, #featuredCourses .course-card");

            courses.forEach(function(course) {
                var courseCategory = course.getAttribute('data-category');
                if (courseCategory === category) {
                    course.style.display = "block";
                } else {
                    course.style.display = "none";
                }
            });

            // Scroll to courses
            document.getElementById('allCourses').scrollIntoView({ behavior: 'smooth' });
        });
    });
</script>

<style>
    .btn-gold {
        background: linear-gradient(135deg, #FFD700, #DAA520);
        border: none;
        color: #006666;
        font-weight: bold;
        transition: all 0.3s ease;
    }

        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(218,165,32,0.4);
            color: #006666;
        }

    .category-card {
        transition: transform 0.3s ease;
        cursor: pointer;
        border-radius: 12px;
        background: white;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .carousel-caption {
        bottom: 20%;
    }

    .course-card {
        transition: transform 0.3s ease;
    }

        .course-card:hover {
            transform: translateY(-5px);
        }
</style>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}