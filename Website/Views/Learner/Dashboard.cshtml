@model List<Website.Models.Content>
@{
    ViewData["Title"] = "Learner Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <img src="~/Images/DefaultPic.png" alt="Profile"
                             style="width: 70px; height: 70px; border-radius: 50%; object-fit: cover; border: 3px solid white; margin-right: 20px;">
                        <div>
                            <h2 class="mb-0">Welcome back, @ViewBag.UserName!</h2>
                            <p class="mb-0">You are logged in as <strong>Learner</strong></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-book fa-3x text-primary"></i>
                    <h3 class="mt-2">@ViewBag.TotalCourses</h3>
                    <p>Available Courses</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-podcast fa-3x text-success"></i>
                    <h3 class="mt-2">0</h3>
                    <p>Podcasts</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-certificate fa-3x text-warning"></i>
                    <h3 class="mt-2">0</h3>
                    <p>Certificates Earned</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-md-12">
            
            <a asp-action="MyCourses" class="btn btn-success ms-2">
                <i class="fas fa-play-circle"></i> My Learning
            </a>
          
        </div>
    </div>

    <!-- Featured Content -->
    <div class="row mb-3">
        <div class="col-md-12">
            <h3><i class="fas fa-star text-warning"></i> Featured Content</h3>
            <hr />
        </div>
    </div>

    <div class="row">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@(item.ThumbnailUrl ?? "https://placehold.co/400x200/008080/white?text=" + item.Title)"
                             class="card-img-top" alt="@item.Title" style="height: 180px; object-fit: cover;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <span class="badge bg-primary">@item.Category</span>
                                <span class="text-success fw-bold">$@item.Price</span>
                            </div>
                            <h5 class="card-title mt-2">@item.Title</h5>
                            <p class="card-text text-muted">@(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)</p>
                        </div>
                        <div class="card-footer bg-white">
                            <a asp-action="ContentDetails" asp-route-id="@item.Id" class="btn btn-primary w-100">View Details</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-md-12">
                <div class="alert alert-info text-center">No content available yet.</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}