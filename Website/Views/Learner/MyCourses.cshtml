@{
    ViewData["Title"] = "My Courses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h2 class="mb-0"><i class="fas fa-play-circle"></i> My Learning</h2>
        </div>
        <div class="card-body">
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle fa-2x"></i>
                <h4>You haven't enrolled in any courses yet</h4>
                <p>Browse our content and start learning today!</p>
                <a asp-action="BrowseCourses" class="btn btn-primary">Browse Content</a>
            </div>
        </div>
    </div>
</div>