@model List<Website.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2><i class="fas fa-shopping-bag"></i> My Orders</h2>
            <hr />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-md-12">
                @foreach (var order in Model)
                {
                    <div class="card mb-4 shadow-sm">
                        <div class="card-header bg-light">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Order #:</strong> @order.OrderNumber
                                </div>
                                <div class="col-md-6 text-end">
                                    <strong>Date:</strong> @order.OrderDate.ToString("MMMM dd, yyyy")
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Item</th>
                                            <th class="text-center">Quantity</th>
                                            <th class="text-end">Unit Price</th>
                                            <th class="text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <tr>
                                                <td>@item.ContentTitle</td>
                                                <td class="text-center">@item.Quantity</td>
                                                <td class="text-end">$@item.Price.ToString("0.00")</td>
                                                <td class="text-end">$@((item.Price * item.Quantity).ToString("0.00"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-success">
                                            <td colspan="3" class="text-end fw-bold">Total:</td>
                                            <td class="text-end fw-bold">$@order.TotalAmount.ToString("0.00")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="text-end mt-2">
                                <a asp-controller="Order" asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle"></i> You haven't placed any orders yet.
            <br />
            <a asp-controller="Store" asp-action="Index" class="btn btn-primary mt-3">
                Start Shopping
            </a>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}