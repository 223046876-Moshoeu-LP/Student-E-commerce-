@model List<Website.Models.Cart>
@{
    
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = "Checkout";
    var subtotal = Model?.Sum(c => c.ContentPrice * c.Quantity) ?? 0;
    var discountAmount = ViewBag.DiscountAmount ?? 0m;
    var discountPercentage = ViewBag.DiscountPercentage ?? 0;
    var appliedPromoCode = ViewBag.AppliedPromotionCode ?? "";
    var totalAfterDiscount = subtotal - discountAmount;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Website</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        .checkout-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .card {
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .card-header {
            padding: 15px 20px;
            font-weight: 600;
        }

        .form-label {
            font-weight: 500;
            margin-bottom: 5px;
        }

        .order-summary-item {
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

        .total-row {
            font-size: 1.1em;
            font-weight: bold;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 2px solid #ddd;
        }

        .promo-badge {
            background-color: #28a745;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.85em;
        }
    </style>
</head>
<body>
    <div class="checkout-container">
        <h2 class="mb-4"><i class="fas fa-shopping-cart"></i> Checkout</h2>

        <!-- Show messages -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row">
            <!-- Billing & Payment Form -->
            <div class="col-lg-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h4 class="mb-0"><i class="fas fa-credit-card"></i> Billing Information</h4>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-action="Checkout" id="checkoutForm">
                            @Html.AntiForgeryToken()

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">First Name *</label>
                                    <input type="text" name="firstName" class="form-control" required placeholder="John" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Last Name *</label>
                                    <input type="text" name="lastName" class="form-control" required placeholder="Doe" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email Address *</label>
                                <input type="email" name="email" class="form-control" value="@User.Identity.Name" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Phone Number</label>
                                <input type="tel" name="phone" class="form-control" placeholder="(555) 123-4567" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Address</label>
                                <textarea name="address" class="form-control" rows="2" placeholder="123 Main St, City, State, ZIP"></textarea>
                            </div>

                            <!-- Promo Code Section -->
                            <div class="mt-4 pt-3 border-top">
                                <h5><i class="fas fa-tag"></i> Promo Code</h5>

                                @if (!string.IsNullOrEmpty(appliedPromoCode))
                                {
                                    <div class="alert alert-success d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="fas fa-check-circle"></i>
                                            <strong>@appliedPromoCode</strong> applied! (@discountPercentage% OFF)
                                            <br />
                                            <small>You saved: $@discountAmount.ToString("F2")</small>
                                        </div>
                                        <form asp-action="RemovePromotionCode" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-times"></i> Remove
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <div class="input-group mb-2">
                                        <input type="text" id="promoCode" class="form-control" placeholder="Enter promo code (e.g., WEEKEND DEAL, FLASH SALE)" />
                                        <button type="button" id="applyPromoBtn" class="btn btn-warning">
                                            <i class="fas fa-gift"></i> Apply
                                        </button>
                                    </div>
                                    <div id="promoMessage" class="small text-muted"></div>

                                    <!-- Show available promos -->
                                    @if (ViewBag.ActivePromotions != null && ((List<Promotion>)ViewBag.ActivePromotions).Any())
                                    {
                                        <div class="mt-2">
                                            <small class="text-muted">
                                                Available codes:
                                                @foreach (var promo in ViewBag.ActivePromotions)
                                                {
                                                    <span class="badge bg-primary me-1">@promo.Title</span>
                                                }
                                            </small>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Payment Information -->
                            <div class="mt-4 pt-3 border-top">
                                <h5><i class="fas fa-lock"></i> Payment Information (Simulation)</h5>
                                <div class="alert alert-info small">
                                    <i class="fas fa-info-circle"></i> This is a demo. No real charges will be made.
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Card Number *</label>
                                    <input type="text" name="cardNumber" class="form-control" placeholder="4242 4242 4242 4242" required />
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Expiry Date *</label>
                                        <input type="text" name="expiry" class="form-control" placeholder="MM/YY" required />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">CVV *</label>
                                        <input type="text" name="cvv" class="form-control" placeholder="123" required />
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success btn-lg w-100 mt-3">
                                <i class="fas fa-check-circle"></i> Place Order
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-5">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-receipt"></i> Order Summary</h5>
                    </div>
                    <div class="card-body">
                        @if (Model != null && Model.Any())
                        {
                            <div class="order-items mb-3">
                                @foreach (var item in Model)
                                {
                                    <div class="order-summary-item d-flex justify-content-between">
                                        <div>
                                            <strong>@item.ContentTitle</strong>
                                            <br />
                                            <small class="text-muted">Qty: @item.Quantity</small>
                                        </div>
                                        <div class="text-end">
                                            <span>$@((item.ContentPrice * item.Quantity).ToString("F2"))</span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between">
                                <span>Subtotal</span>
                                <span>$@subtotal.ToString("F2")</span>
                            </div>

                            @if (discountAmount > 0)
                            {
                                <div class="d-flex justify-content-between text-success mt-2">
                                    <span>
                                        <i class="fas fa-tag"></i> Discount (@discountPercentage%)
                                    </span>
                                    <span>-$@discountAmount.ToString("F2")</span>
                                </div>
                            }

                            <div class="total-row d-flex justify-content-between mt-3 pt-2">
                                <strong>Total</strong>
                                <strong class="text-success" style="font-size: 1.3rem;">$@totalAfterDiscount.ToString("F2")</strong>
                            </div>

                            @if (!string.IsNullOrEmpty(appliedPromoCode))
                            {
                                <div class="mt-3 text-center">
                                    <span class="promo-badge">
                                        <i class="fas fa-check"></i> @appliedPromoCode - @discountPercentage% OFF
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No items in cart</p>
                                <a href="@Url.Action("Index", "Store")" class="btn btn-primary">Continue Shopping</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Simple AJAX for applying promo code
        const applyBtn = document.getElementById('applyPromoBtn');
        if (applyBtn) {
            applyBtn.addEventListener('click', async function() {
                const promoCode = document.getElementById('promoCode').value.trim();
                const messageDiv = document.getElementById('promoMessage');

                if (!promoCode) {
                    messageDiv.innerHTML = '<span class="text-warning">Please enter a promo code</span>';
                    return;
                }

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                try {
                    const formData = new FormData();
                    formData.append('promotionCode', promoCode);

                    const response = await fetch('/Store/ApplyPromotionCode', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        messageDiv.innerHTML = '<span class="text-success">✓ ' + result.message + '</span>';
                        // Reload to show updated cart
                        setTimeout(() => location.reload(), 500);
                    } else {
                        messageDiv.innerHTML = '<span class="text-danger">✗ ' + result.message + '</span>';
                    }
                } catch (error) {
                    messageDiv.innerHTML = '<span class="text-danger">✗ Error applying promo code</span>';
                    console.error('Error:', error);
                }
            });
        }
    </script>
</body>
</html>