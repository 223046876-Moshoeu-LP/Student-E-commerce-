@model List<Website.Models.Purchase>
@{
    ViewData["Title"] = "My Purchases";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h2 class="mb-0"><i class="fas fa-shopping-bag"></i> My Purchases</h2>
                    <p class="mb-0">All your purchased content is available here</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Item</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Purchase Date</th>
                                <th>Order #</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                            {
                                                <img src="@item.ThumbnailUrl" alt="@item.ContentTitle" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px; margin-right: 10px;">
                                            }
                                            else
                                            {
                                                <div style="width: 50px; height: 50px; background: #008080; border-radius: 8px; margin-right: 10px; display: flex; align-items: center; justify-content: center;">
                                                    <i class="fas fa-file-alt text-white"></i>
                                                </div>
                                            }
                                            <div>
                                                <strong>@item.ContentTitle</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-primary">@item.ContentCategory</span></td>
                                    <td class="text-success">$@item.Price.ToString("F2")</td>
                                    <td>@item.PurchaseDate.ToString("MMM dd, yyyy")</td>
                                    <td><small class="text-muted">@item.OrderNumber</small></td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Store" asp-action="ContentDetails" asp-route-id="@item.ContentId" class="btn btn-info btn-sm" title="View Details">
                                                <i class="fas fa-info-circle"></i> View
                                            </a>
                                            @if (!string.IsNullOrEmpty(item.ContentUrl))
                                            {
                                                <a asp-controller="Store" asp-action="DownloadPurchasedContent" asp-route-id="@item.Id" class="btn btn-success btn-sm" title="Download">
                                                    <i class="fas fa-download"></i> Download
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-bag fa-4x text-muted mb-3"></i>
            <h4>No purchases yet</h4>
            <p>You haven't purchased any content yet.</p>
            <a asp-controller="Store" asp-action="Index" class="btn btn-primary btn-lg">
                Browse Content
            </a>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}