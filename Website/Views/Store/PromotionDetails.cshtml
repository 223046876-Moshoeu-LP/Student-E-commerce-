@model Website.Models.Promotion
@{
    ViewData["Title"] = Model?.Title;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <img src="@(Model?.ImageUrl ?? "/images/default-promo.jpg")"
                     class="card-img-top" alt="@Model?.Title"
                     style="height: 350px; object-fit: cover;"
                     onerror="this.onerror=null; this.src='/images/default-promo.jpg';">
                <div class="card-body">
                    <div class="badge bg-danger mb-2">Limited Time Offer</div>
                    <h2>@Model?.Title</h2>
                    <p>@Model?.Description</p>

                    <div class="alert alert-warning mt-3">
                        <i class="fas fa-tag"></i>
                        @if (Model?.DiscountPercentage.HasValue == true)
                        {
                            <strong>@Model.DiscountPercentage% OFF</strong>
                            <text> on all eligible content!</text>
                        }
                        else
                        {
                            <strong>Special offer!</strong>
                        }
                    </div>

                    <div class="mt-3">
                        <h5>Offer Details</h5>
                        <ul>
                            <li><i class="fas fa-calendar"></i> Valid from @Model?.StartDate.ToString("MMMM dd, yyyy") to @Model?.EndDate.ToString("MMMM dd, yyyy")</li>
                            @if (Model?.DiscountPercentage.HasValue == true)
                            {
                                <li><i class="fas fa-percent"></i> @Model.DiscountPercentage% discount automatically applied at checkout</li>
                            }
                            <li><i class="fas fa-tag"></i> Use code: <strong>@($"PROMO{Model?.Id}")</strong> at checkout</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-body text-center">
                    <h3>Don't Miss Out!</h3>
                    <hr />
                    <p>This offer ends in:</p>
                    <div id="countdown" class="display-4 text-warning fw-bold"></div>
                    <hr />
                    <a asp-action="Index" class="btn btn-primary w-100 mb-2">
                        <i class="fas fa-store"></i> Browse Store
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Countdown timer
    const endDate = new Date("@Model?.EndDate.ToString("yyyy-MM-dd")");
    endDate.setHours(23, 59, 59);

    function updateCountdown() {
        const now = new Date();
        const diff = endDate - now;

        if (diff <= 0) {
            document.getElementById("countdown").innerHTML = "Offer Expired!";
            return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        document.getElementById("countdown").innerHTML = `${days}d ${hours}h ${minutes}m ${seconds}s`;
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
</script>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}